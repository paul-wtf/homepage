---
import { tools, palette } from '../data/tools';
---
<section id="tools" data-ws="3" class="tools section-shell" data-reveal>
  <h2 class="section-title"><span class="ws" aria-hidden="true">3</span>Tools</h2>
  <!-- Fastfetch-Fenster: user@host, Trennlinie, key/value, Palette. -->
  <div class="window fetch">
    <pre class="logo" aria-hidden="true">  <span class="b">\</span>  \ <span class="b">//</span>
 ==<span class="b">\</span>__\/ <span class="b">//</span>
   //   \<span class="b">//</span>
==//     //==
 <span class="b">//</span>\___<span class="b">//</span>
<span class="b">//</span> /\  <span class="b">\</span>==
  <span class="b">//</span> \  <span class="b">\</span></pre>
    <div class="info">
      <p class="host">paul@paul.wtf</p>
      <dl>
        {tools.map(({ label, value }) => (
          <div class="row">
            <dt>{label}</dt>
            <dd>{value}</dd>
          </div>
        ))}
      </dl>
      <div class="palette" aria-hidden="true">
        {palette.map((c) => <span style={`background:${c}`} />)}
      </div>
    </div>
  </div>
</section>

<style>
  .section-title {
    margin-bottom: 1.5rem;
  }
  .fetch {
    max-width: 820px;
    padding: 1.5rem 1.75rem;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0 2rem;
    align-items: start;
  }
  .logo {
    margin: 0;
    color: var(--teal);
    font-weight: 700;
    font-size: clamp(0.62rem, 1.45vw, 0.95rem);
    line-height: 1.25;
    white-space: pre;
  }
  .logo .b { color: var(--sky); }
  .info { min-width: 0; }
  .host {
    margin: 0 0 0.35rem;
    color: var(--text);
    font-weight: 700;
    font-size: 0.95rem;
  }
  .host::after {
    content: '';
    display: block;
    margin-top: 0.55rem;
    height: 2px;
    background: repeating-linear-gradient(90deg, var(--surface0) 0 10px, transparent 10px 16px);
  }
  dl {
    margin: 0.85rem 0 1.1rem;
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 0.35rem 1.5rem;
  }
  .row { display: contents; }
  dt {
    color: var(--overlay2);
    font-size: 0.88rem;
    text-transform: lowercase;
  }
  dd {
    margin: 0;
    color: var(--text);
    font-size: 0.88rem;
  }
  .palette {
    display: flex;
    gap: 0.4rem;
  }
  .palette span {
    width: 1rem;
    height: 1rem;
    border-radius: 4px;
  }
  @media (max-width: 600px) {
    .fetch { grid-template-columns: 1fr; gap: 1rem; }
  }
</style>
