---
import { projects } from '../data/projects';
import { previews } from '../data/previews';
import ProjectCard from './ProjectCard.astro';

const featured = projects.filter((p) => p.featured);
const others = projects.filter((p) => !p.featured);
---
<section id="projects" data-ws="2" class="projects section-shell" data-reveal>
  <h2 class="section-title"><span class="ws" aria-hidden="true">2</span>Projekte</h2>

  {featured.map((p) => <ProjectCard project={p} preview={previews[p.name]} />)}

  <div class="grid">
    {others.map((p) => <ProjectCard project={p} />)}
  </div>
</section>

<style>
  /* Fenster-Gaps wie hyprland zen: gaps_out 16 → 1rem */
  .projects {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .section-title {
    margin-bottom: 0.5rem;
  }
  .grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }
  /* 1fr-Tracks dürfen unter die min-content-Breite der Repo-URLs schrumpfen */
  .grid > :global(*) { min-width: 0; }
  @media (max-width: 720px) {
    .grid { grid-template-columns: 1fr; }
  }
</style>
