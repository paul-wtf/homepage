---
// „Wallpaper": Firewatch-Ridgelines wie
// dotfiles/wallpapers/firewatchcatpuccinmochagreen.png — fast
// tonwertgleiche Hügelketten über dem Crust, dazu ein blasser
// Teal-Mond. Fixed, liegt hinter allem Inhalt im Viewport.
---
<div class="wallpaper" data-wallpaper aria-hidden="true">
  <svg viewBox="0 0 1600 900" preserveAspectRatio="xMidYMax slice">
    <g class="orb moon" data-moon>
      <circle cx="1190" cy="300" r="110" opacity="0.09" data-moon-halo />
      <circle cx="1190" cy="300" r="72" opacity="0.24" data-moon-disc />
      <path data-moon-lit />
    </g>
    <g class="orb sun" data-sun>
      <circle cx="1190" cy="300" r="150" opacity="0.05" />
      <circle cx="1190" cy="300" r="110" opacity="0.1" />
      <circle cx="1190" cy="300" r="72" opacity="0.3" />
    </g>
    <path class="hill hill-1" opacity="0.55" d="M0 560 L140 480 L300 545 L470 430 L640 530 L820 455 L990 540 L1160 470 L1330 550 L1470 500 L1600 555 L1600 900 L0 900 Z" />
    <path class="hill hill-2" opacity="0.8" d="M0 640 L180 560 L340 625 L520 540 L720 630 L900 560 L1090 645 L1280 575 L1440 640 L1600 590 L1600 900 L0 900 Z" />
    <path class="hill hill-3" d="M0 730 L200 655 L380 715 L580 640 L790 725 L1000 660 L1210 730 L1420 670 L1600 720 L1600 900 L0 900 Z" />
    <path class="hill hill-4" d="M0 810 L240 750 L460 800 L700 740 L950 805 L1200 750 L1430 800 L1600 765 L1600 900 L0 900 Z" />
  </svg>
  <canvas data-particles hidden></canvas>
</div>

<style>
  .wallpaper {
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }
  svg,
  canvas {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
  }
  canvas { color: var(--text); }
  canvas[hidden] { display: none; }

  .orb { transition: opacity var(--dur) var(--ease); }
  .moon { fill: var(--teal); }
  .sun {
    display: none;
    fill: var(--sun);
  }
  .wallpaper[data-sky='day'] .moon { display: none; }
  .wallpaper[data-sky='day'] .sun { display: inline; }
  .wallpaper[data-dim] .orb { opacity: 0.5; }

  [data-moon-lit] { display: none; }
  .wallpaper[data-phase] [data-moon-lit] {
    display: inline;
    opacity: 0.2;
  }
  .wallpaper[data-phase] [data-moon-disc] { opacity: 0.07; }
  .wallpaper[data-phase] [data-moon-halo] { opacity: calc(0.03 + 0.06 * var(--moon-light)); }

  .hill { transition: fill var(--dur) var(--ease); }
  .hill-1 { fill: var(--hill-1); }
  .hill-2 { fill: var(--hill-2); }
  .hill-3 { fill: var(--hill-3); }
  .hill-4 { fill: var(--hill-4); }
  .wallpaper[data-weather='fog'] .hill-1 { fill: color-mix(in srgb, var(--hill-1), var(--overlay0) 26%); }
  .wallpaper[data-weather='fog'] .hill-2 { fill: color-mix(in srgb, var(--hill-2), var(--overlay0) 20%); }
  .wallpaper[data-weather='fog'] .hill-3 { fill: color-mix(in srgb, var(--hill-3), var(--overlay0) 14%); }
  .wallpaper[data-weather='fog'] .hill-4 { fill: color-mix(in srgb, var(--hill-4), var(--overlay0) 8%); }

  @media (prefers-reduced-motion: reduce) {
    .orb,
    .hill { transition: none; }
  }
</style>

<script>
  import { subscribe } from '../scripts/live/status';
  import { illumination, moonPath, moonPhase } from '../scripts/wallpaper/moon';
  import { createParticles } from '../scripts/wallpaper/particles';
  import { sceneFor } from '../scripts/wallpaper/scene';

  const root = document.querySelector<HTMLElement>('[data-wallpaper]');
  const canvas = root?.querySelector<HTMLCanvasElement>('[data-particles]');
  const disc = root?.querySelector<SVGCircleElement>('[data-moon-disc]');
  const lit = root?.querySelector<SVGPathElement>('[data-moon-lit]');

  function showPhase(el: HTMLElement, night: boolean): void {
    if (!night || !disc || !lit) {
      el.removeAttribute('data-phase');
      return;
    }
    const phase = moonPhase(new Date());
    el.dataset.phase = phase.toFixed(3);
    el.style.setProperty('--moon-light', illumination(phase).toFixed(3));
    lit.setAttribute('d', moonPath(phase, disc.cx.baseVal.value, disc.cy.baseVal.value, disc.r.baseVal.value));
  }

  if (root && canvas) {
    const particles = createParticles(canvas);
    subscribe((status) => {
      const scene = sceneFor(status?.weather ?? null);
      if (!scene) {
        root.removeAttribute('data-sky');
        root.removeAttribute('data-weather');
        root.removeAttribute('data-dim');
        showPhase(root, false);
        particles.set(null, 0);
        return;
      }
      showPhase(root, scene.sky === 'night');
      root.dataset.sky = scene.sky;
      root.dataset.weather = scene.weather;
      root.toggleAttribute('data-dim', scene.dim);
      particles.set(scene.weather === 'rain' || scene.weather === 'snow' ? scene.weather : null, scene.intensity);
    });
  }
</script>
