---
import Layout from '../layouts/Layout.astro';
---
<Layout title="404 — paul.wtf" description="Diese Seite existiert nicht.">
  <!-- Rot ist für Kritisches reserviert — das hier ist der eine Fall. -->
  <main>
    <div class="window box">
      <h1 class="sr-only">404: Diese Seite gibt es nicht</h1>
      <p class="line"><span class="prompt">paul@paul.wtf ~&gt;</span> <span data-path>./diese-seite</span></p>
      <p class="err">fish: Unknown command: <span data-path>./diese-seite</span></p>
      <p class="line"><span class="prompt">paul@paul.wtf ~&gt;</span> echo $status</p>
      <p>404</p>
      <p class="line" aria-hidden="true"><span class="prompt">paul@paul.wtf ~&gt;</span> <span class="cur"></span></p>
      <a class="btn" href="/">Zur Startseite →</a>
    </div>
  </main>

  <style>
    main {
      min-height: 100vh;
      display: grid;
      place-items: center;
      padding: 2rem;
    }
    .box {
      width: min(100%, 560px);
      padding: clamp(1.5rem, 5vw, 2.25rem);
      font-size: 0.92rem;
      line-height: 1.6;
    }
    p {
      margin: 0;
      color: var(--text);
      overflow-wrap: anywhere;
    }
    .prompt { color: var(--subtext0); }
    .err { color: var(--red); }
    .cur {
      display: inline-block;
      width: 0.6em;
      height: 1.15em;
      vertical-align: -0.2em;
      background: var(--teal);
      animation: blink 1.1s steps(1) infinite;
    }
    @keyframes blink { 50% { opacity: 0; } }
    .btn { margin-top: 1.75rem; }
    @media (prefers-reduced-motion: reduce) {
      .cur { animation: none; }
    }
  </style>

  <script>
    import { initScrollFocus } from '../scripts/scroll-focus';
    initScrollFocus();

    let path = location.pathname;
    try {
      path = decodeURIComponent(path);
    } catch {}
    for (const el of document.querySelectorAll('[data-path]')) el.textContent = path;
  </script>
</Layout>
