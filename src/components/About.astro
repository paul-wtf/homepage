---
import { about } from '../data/about';
---
<section id="about" data-ws="1" class="about section-shell" data-reveal>
  <h2 class="section-title"><span class="ws" aria-hidden="true">1</span>Über mich</h2>
  <article class="window body">
    {about.paragraphs.map((p) => <p>{p}</p>)}
  </article>
</section>

<style>
  .section-title {
    margin-bottom: 1.5rem;
  }
  .body {
    padding: clamp(1.5rem, 3vw, 2.25rem);
  }
  .body p {
    color: var(--text);
    font-size: 0.95rem;
    line-height: 1.75;
    margin: 0 0 1rem;
    max-width: 72ch;
  }
  .body p:last-child { margin-bottom: 0; }
  .body p:not(:first-child) {
    color: var(--subtext0);
  }
</style>
