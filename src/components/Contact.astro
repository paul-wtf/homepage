---
import Email from './Email.astro';
import { contacts, contactIcons, emailParts } from '../data/contact';

const [github, discord, youtube] = ['github', 'discord', 'youtube'].map(
  (k) => contacts.find((c) => c.kind === k)!
);
const email = contacts.find((c) => c.kind === 'email')!;
---
<section id="contact" data-ws="6" class="contact section-shell" data-reveal>
  <h2 class="section-title"><span class="ws" aria-hidden="true">6</span>Kontakt</h2>
  <div class="grid">

    <a class="window window--focusable tile" href={github.href} target="_blank" rel="noopener noreferrer">
      <svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true">
        <path fill="currentColor" d={contactIcons.github}/>
      </svg>
      <div>
        <span class="label">{github.label}</span>
        <span class="value">{github.value}</span>
      </div>
    </a>

    <button type="button" class="window window--focusable tile discord" data-discord={discord.value}>
      <svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true">
        <path fill="currentColor" d={contactIcons.discord}/>
      </svg>
      <div>
        <span class="label">{discord.label}</span>
        <span class="value" role="status" data-discord-text>{discord.value}</span>
        <span class="sr-only">— Benutzernamen in Zwischenablage kopieren</span>
      </div>
    </button>

    <a class="window window--focusable tile" href={youtube.href} target="_blank" rel="noopener noreferrer">
      <svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true">
        <path fill="currentColor" d={contactIcons.youtube}/>
      </svg>
      <div>
        <span class="label">{youtube.label}</span>
        <span class="value">{youtube.value}</span>
      </div>
    </a>

    <Email user={emailParts.user} domain={emailParts.domain} label={email.label} placeholder={email.value} />

  </div>
</section>

<style>
  .section-title {
    margin-bottom: 1.5rem;
  }
  .grid {
    display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem;
  }
  .tile {
    display: flex; align-items: center; gap: 0.85rem;
    padding: 1rem 1.15rem;
    text-decoration: none; color: inherit;
    border: 0;
    cursor: pointer; text-align: left;
    font: inherit;
    min-width: 0;
  }
  /* Ohne min-width:0 greift das text-overflow: ellipsis der .value nie —
     automatic minimum sizes lassen Grid-Items sonst nicht schrumpfen. */
  .tile > div { min-width: 0; }
  /* Icons teal — statIcon(zen) aus Theme.qml */
  .tile svg { flex-shrink: 0; color: var(--teal); }
  .label {
    display: block; font-size: 0.72rem;
    text-transform: lowercase;
    color: var(--overlay2);
  }
  .value {
    display: block; color: var(--text); font-size: 0.88rem;
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  .discord.copied .value { color: var(--green); }

  @media (max-width: 880px) { .grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 480px) { .grid { grid-template-columns: 1fr; } }
</style>

<script>
  import '../scripts/contact-actions';
</script>
