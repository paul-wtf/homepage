---
import { Image } from 'astro:assets';
import portrait from '../../assets/profilepicture.png';
import { about } from '../../data/about';
import { projects } from '../../data/projects';
import { previews } from '../../data/previews';
import { commitDate, projectMeta } from '../../data/github';
import { changelog, compareUrl, REPO } from '../../data/changelog';
import { loadTil } from '../../data/til-load';
import ProjectMeta from '../ProjectMeta.astro';
import { tools, palette } from '../../data/tools';
import NixLogo from '../NixLogo.astro';
import { workstation, laptop, server } from '../../data/hardware';
import { bmw, pax, paxAge, cats } from '../../data/sidefacts';
import { bmwImage, catImages, paxImage } from '../../data/sidefact-images';
import { contacts, contactIcons, emailParts } from '../../data/contact';
import { toLang } from '../../data/i18n';
import { ui } from '../../data/ui';

const lang = toLang(Astro.currentLocale);
const t = ui[lang];
const me = about[lang];
const fox = pax[lang];
const home = {
  about: `~/${t.paths.about}`,
  projects: `~/${t.paths.projects}`,
  cats: `~/sidefacts/${t.paths.cats}`,
  contact: `~/${t.paths.contact}`,
  music: `~/sidefacts/${t.paths.music}`,
};

const featured = projects.filter((p) => p.featured);
const others = projects.filter((p) => !p.featured);
const meta = await projectMeta();
const releases = await changelog();
const til = loadTil(lang);
const contact = Object.fromEntries(contacts.map((c) => [c.kind, c])) as Record<
  (typeof contacts)[number]['kind'],
  (typeof contacts)[number]
>;
---
<template data-window data-ws="1" data-label={t.windows.about} data-path={home.about}>
  <span class="path">{home.about}</span>
  <h3>{me.name}</h3>
  <p class="tagline">{me.tagline}</p>
  {me.paragraphs.map((p) => <p>{p}</p>)}
</template>

<template data-window data-ws="1" data-label={t.windows.portrait} data-path={`${home.about}/portrait`}>
  <span class="path">{`${home.about}/portrait`}</span>
  <Image src={portrait} alt={t.hero.portraitAlt} width={480} height={480} decoding="async" />
</template>

{til.length > 0 && (
  <template data-window data-ws="1" data-label={t.windows.til} data-path="~/til">
    <span class="path">~/til</span>
    <h3>{t.windows.til}</h3>
    <ol class="plain til">
      {til.map((e) => (
        <li>
          <time datetime={e.date}>{commitDate(e.date, lang)}</time>
          <p set:html={e.html} />
          {e.link && <a class="repo source" href={e.link} target="_blank" rel="noopener noreferrer">{e.host} ↗</a>}
        </li>
      ))}
    </ol>
  </template>
)}

{featured.map((p) => (
  <template data-window data-ws="2" data-label={p.name} data-path={`${home.projects}/${p.name}`}>
    <span class="path">{`${home.projects}/${p.name}`}</span>
    {previews[p.name] && (
      <div class="visual">
        <Image
          src={previews[p.name]}
          alt={t.projects.previewAlt(p.name)}
          widths={[640, 960]}
          sizes="(min-width: 900px) 640px, 100vw"
          decoding="async"
        />
      </div>
    )}
    <div class="head">
      <h3>{p.name}</h3>
      {p.liveUrl && <span class="live" data-project={p.name}><span data-word>live</span> · {p.liveUrl.replace(/^https?:\/\//, '')}</span>}
    </div>
    <p class="desc">{p.description[lang]}</p>
    <ul class="stack">
      {p.stack.map((s) => <li>{s}</li>)}
    </ul>
    <div class="links">
      <a class="repo" href={p.liveUrl ?? p.repoUrl} target="_blank" rel="noopener noreferrer">{p.repoUrl.replace('https://', '')}</a>
      <ProjectMeta meta={meta[p.name]} />
    </div>
  </template>
))}

<template data-window data-ws="2" data-label={t.windows.projects} data-path={home.projects}>
  <span class="path">{home.projects}</span>
  <ul class="plain projects-list">
    {others.map((p) => (
      <li>
        <a href={p.liveUrl ?? p.repoUrl} target="_blank" rel="noopener noreferrer">{p.name}</a>
        <p class="desc">{p.description[lang]}</p>
        <ul class="stack">
          {p.stack.map((s) => <li>{s}</li>)}
        </ul>
        <ProjectMeta meta={meta[p.name]} />
      </li>
    ))}
  </ul>
</template>

<template data-window data-ws="3" data-label={t.windows.system} data-path="~/tools/fastfetch">
  <span class="path">~/tools/fastfetch</span>
  <div class="fetch">
    <NixLogo />
    <div class="info">
      <p class="host">paul@paul.wtf</p>
      <dl>
        {tools.map(({ label, value }) => (
          <div class="row">
            <dt>{label}</dt>
            <dd>{value}</dd>
          </div>
        ))}
      </dl>
      <div class="palette" aria-hidden="true">
        {palette.map((c) => <span style={`background:${c}`} />)}
      </div>
    </div>
  </div>
</template>

{releases && (
  <template data-window data-changelog data-ws="3" data-label={t.windows.changelog} data-path="~/tools/changelog">
    <span class="path">~/tools/changelog</span>
    <div class="changelog">
      <h3>{t.changelog.title}</h3>
      <ol class="plain releases">
        {releases.map((r) => (
          <li class="release">
            <div class="release-head">
              <a class="tag" href={compareUrl(r)} target="_blank" rel="noopener noreferrer" aria-label={t.changelog.compare(r.tag)}>{r.tag}</a>
              {r.date && <time datetime={r.date}>{commitDate(r.date, lang)}</time>}
            </div>
            {r.changes.length > 0 ? (
              <ul class="plain changes">
                {r.changes.map((c) => (
                  <li data-type={c.type}>
                    <span class="kind">{t.changelog.kinds[c.type]}</span>
                    <span class="text">{c.scope && <span class="scope">{c.scope}</span>}<span class="subject">{c.subject}</span></span>
                  </li>
                ))}
              </ul>
            ) : (
              <p class="maintenance">{t.changelog.maintenance}</p>
            )}
          </li>
        ))}
      </ol>
      <a class="repo" href={`https://github.com/${REPO}/tags`} target="_blank" rel="noopener noreferrer">{t.changelog.all}</a>
    </div>
  </template>
)}

<template data-window data-ws="4" data-label="Workstation" data-path="~/hardware/workstation">
  <span class="path">~/hardware/workstation</span>
  <h3 class="card-title">workstation</h3>
  {workstation.map((cat) => (
    <div class="cat">
      <span class="cat-label">{cat.label}</span>
      <ul class="plain">
        {cat.items.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  ))}
</template>

<template data-window data-needs="cluster" data-ws="4" data-label={t.windows.homelab} data-path="~/hardware/homelab">
  <span class="path">~/hardware/homelab</span>
  <div class="cluster" data-cluster>
    <h3 class="card-title">homelab</h3>
    <dl class="cluster-stats" data-cluster-stats></dl>
    <div class="cluster-table">
      <ul class="plain cluster-nodes" data-cluster-nodes></ul>
      <div class="cluster-total" data-cluster-total hidden></div>
    </div>
    <div class="cluster-temps" data-cluster-temps hidden>
      <span class="cat-label">{t.cluster.temps}</span>
      <dl></dl>
    </div>
  </div>
</template>

<template data-window data-ws="4" data-label="Laptop" data-path="~/hardware/laptop">
  <span class="path">~/hardware/laptop</span>
  <h3 class="card-title">laptop</h3>
  <p>{laptop}</p>
</template>

<template data-window data-ws="4" data-label="Server" data-path="~/hardware/server">
  <span class="path">~/hardware/server</span>
  <h3 class="card-title">server</h3>
  <p class="muted">{server[lang].hostingNote}</p>
  <ul class="plain server-list">
    {server[lang].lines.map((line) => <li>{line}</li>)}
  </ul>
</template>

<template data-window data-ws="5" data-label="Pax" data-path="~/sidefacts/pax">
  <span class="path">~/sidefacts/pax</span>
  <div class="pax">
    <div class="pax-text">
      <h3>Pax</h3>
      <p class="meta">{fox.species} · {fox.pronouns} · {paxAge}</p>
      <p class="bio"><q>{fox.description}</q></p>
      <div class="taglist">
        <span class="tag-label">{t.sidefacts.likes}</span>
        <ul class="tags">
          {fox.likes.map((l) => <li>{l}</li>)}
        </ul>
      </div>
      <div class="taglist">
        <span class="tag-label">{t.sidefacts.dislikes}</span>
        <ul class="tags dislikes">
          {fox.dislikes.map((l) => <li>{l}</li>)}
        </ul>
      </div>
    </div>
    <div class="pax-photo">
      <Image src={paxImage} alt="Fursona Pax (Arctic Fox)" widths={[300, 545]} sizes="220px" />
    </div>
  </div>
</template>

<template data-window data-ws="5" data-label="BMW" data-path={`~/sidefacts/${t.paths.car}`}>
  <span class="path">{`~/sidefacts/${t.paths.car}`}</span>
  <div class="visual">
    <Image src={bmwImage} alt={bmw.model} widths={[480, 720]} sizes="480px" />
  </div>
  <h3>{bmw.model}</h3>
  <p>{bmw.text[lang]}</p>
</template>

<template data-window data-ws="5" data-label={t.windows.cats} data-path={home.cats}>
  <span class="path">{home.cats}</span>
  <div class="row-cats">
    {cats.map((c) => (
      <div class="cat">
        <div class="visual">
          <Image src={catImages[c.name]} alt={t.sidefacts.catAlt(c.name)} widths={[240, 480]} sizes="240px" />
        </div>
        <h4>{c.name}</h4>
        <p>{c.personality[lang]}</p>
      </div>
    ))}
  </div>
</template>

<template data-window data-needs="week" data-ws="5" data-label={t.windows.music} data-path={home.music}>
  <span class="path">{home.music}</span>
  <div class="week" data-week>
    <div class="week-head">
      <h3>{t.week.title}</h3>
      <span class="meta" data-week-total></span>
    </div>
    <h4>{t.week.artists}</h4>
    <ol class="plain week-artists" data-week-artists></ol>
    <div class="week-grid" data-week-grid role="img" aria-label={t.week.grid}></div>
    <h4>{t.week.tracks}</h4>
    <ol class="plain week-tracks" data-week-tracks></ol>
    <a class="repo" data-week-link href="https://tidalwave.paul.wtf" target="_blank" rel="noopener noreferrer">{t.week.link}</a>
  </div>
</template>

{cats.map((c) => {
  const path = `${home.cats}/${c.name.toLowerCase()}`;
  return (
    <template data-cat={c.name.toLowerCase()} data-ws="5" data-label={c.name} data-path={path}>
      <span class="path">{path}</span>
      <Image src={catImages[c.name]} alt={t.sidefacts.catAlt(c.name)} widths={[480, 960]} sizes="(min-width: 900px) 640px, 100vw" decoding="async" />
    </template>
  );
})}

<template data-window data-ws="6" data-label="GitHub" data-path={`${home.contact}/github`}>
  <span class="path">{`${home.contact}/github`}</span>
  <a class="tile" href={contact.github.href} target="_blank" rel="noopener noreferrer">
    <svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true">
      <path fill="currentColor" d={contactIcons.github}/>
    </svg>
    <div>
      <span class="label">{contact.github.label}</span>
      <span class="value">{contact.github.value}</span>
    </div>
  </a>
</template>

<template data-window data-ws="6" data-label="Discord" data-path={`${home.contact}/discord`}>
  <span class="path">{`${home.contact}/discord`}</span>
  <button type="button" class="tile discord" data-discord={contact.discord.value}>
    <svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true">
      <path fill="currentColor" d={contactIcons.discord}/>
    </svg>
    <div>
      <span class="label">{contact.discord.label}</span>
      <span class="value" role="status" data-discord-text>{contact.discord.value}</span>
      <span class="sr-only">{t.contact.copyHint}</span>
    </div>
  </button>
</template>

<template data-window data-ws="6" data-label="YouTube" data-path={`${home.contact}/youtube`}>
  <span class="path">{`${home.contact}/youtube`}</span>
  <a class="tile" href={contact.youtube.href} target="_blank" rel="noopener noreferrer">
    <svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true">
      <path fill="currentColor" d={contactIcons.youtube}/>
    </svg>
    <div>
      <span class="label">{contact.youtube.label}</span>
      <span class="value">{contact.youtube.value}</span>
    </div>
  </a>
</template>

<template data-window data-ws="6" data-label={t.windows.email} data-path={`${home.contact}/email`}>
  <span class="path">{`${home.contact}/email`}</span>
  <button type="button" class="tile email" data-email-user={emailParts.user} data-email-domain={emailParts.domain}>
    <svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true">
      <path fill="currentColor" d={contactIcons.email}/>
    </svg>
    <div>
      <span class="label">{contact.email.label}</span>
      <span class="value" data-email-text>{t.contact.showEmail}</span>
      <span class="sr-only">{t.contact.mailHint}</span>
    </div>
  </button>
</template>

<template data-window data-ws="6" data-label="GPG" data-path={`${home.contact}/gpg`}>
  <span class="path">{`${home.contact}/gpg`}</span>
  <a class="tile gpg" href={contact.gpg.href}>
    <svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true">
      <path fill="currentColor" d={contactIcons.gpg}/>
    </svg>
    <div>
      <span class="label">{contact.gpg.label}</span>
      <span class="value">{contact.gpg.value}</span>
      <span class="sr-only">{t.contact.keyHint}</span>
    </div>
  </a>
</template>
