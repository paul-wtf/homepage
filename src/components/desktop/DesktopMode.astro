---
import { toLang } from '../../data/i18n';
import { ui } from '../../data/ui';

const lang = toLang(Astro.currentLocale);
const t = ui[lang];
const keys = [
  { keys: ['1', '–', '6'], action: t.desktop.keys.workspace },
  { keys: ['Tab'], action: t.desktop.keys.overview },
  { keys: ['h', 'j', 'k', 'l'], action: t.desktop.keys.focus },
  { keys: ['Enter'], action: t.desktop.keys.terminal },
  { keys: ['Shift', 'Enter'], action: t.desktop.keys.launcher },
  { keys: ['S'], action: t.desktop.keys.scratchpad },
  { keys: ['Q'], action: t.desktop.keys.close },
  { keys: ['F'], action: t.desktop.keys.fullscreen },
  { keys: ['?'], action: t.desktop.keys.keybinds },
  { keys: ['Esc', 'D'], action: t.desktop.keys.leave },
];
---
<div class="wm" data-wm></div>

<div class="lock" data-lock role="dialog" aria-label={t.desktop.lock} tabindex="-1" hidden>
  <p class="lock-time" data-lock-time></p>
  <p class="lock-date" data-lock-date></p>
  <p class="lock-field">{t.desktop.unlock}</p>
  <p class="lock-track" data-lock-track hidden><span class="note" aria-hidden="true">♪</span> <span data-lock-track-text></span></p>
</div>

<div class="launcher" data-launcher role="dialog" aria-modal="true" aria-label="Launcher" hidden>
  <div class="launcher-box">
    <div class="launcher-input">
      <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
        <path fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" d="M10.5 17a6.5 6.5 0 1 1 0-13 6.5 6.5 0 0 1 0 13Zm4.8-1.7L20 20"/>
      </svg>
      <input
        type="text"
        role="combobox"
        aria-label={t.launcher.search}
        aria-expanded="true"
        aria-controls="launcher-list"
        aria-autocomplete="list"
        placeholder={t.launcher.placeholder}
        autocomplete="off"
        autocapitalize="off"
        spellcheck="false"
      />
    </div>
    <ul id="launcher-list" role="listbox" aria-label={t.launcher.results}></ul>
    <p class="launcher-empty" hidden>{t.launcher.empty}</p>
  </div>
</div>

<template data-keybinds data-label={t.desktop.keybinds} data-path="~/keybinds">
  <span class="path">~/keybinds</span>
  <h3>{t.desktop.keybinds}</h3>
  <dl class="keys">
    {keys.map((k) => (
      <div class="row">
        <dt>{k.keys.map((key) => (key === '–' ? <span>–</span> : <kbd>{key}</kbd>))}</dt>
        <dd>{k.action}</dd>
      </div>
    ))}
  </dl>
  <p class="muted">{t.desktop.followMouse}</p>
</template>

<style is:global>
  html.desktop-on { overflow: hidden; }

  main {
    transition:
      opacity var(--dur-fast) var(--ease),
      transform var(--dur) var(--ease-out);
  }
  html.desktop-on main {
    opacity: 0;
    transform: scale(0.97);
  }

  .wm {
    position: fixed;
    top: var(--viewport-top);
    right: var(--frame);
    bottom: var(--frame);
    left: var(--frame);
    z-index: 50;
    overflow: hidden;
    visibility: hidden;
    pointer-events: none;
  }
  html.desktop-on .wm,
  .wm.is-leaving { visibility: visible; }
  html.desktop-on .wm { pointer-events: auto; }

  .wm-layer {
    position: absolute;
    inset: 0;
    transform-origin: 0 0;
    border-radius: calc(var(--r-window) / var(--overview-scale, 1));
    transition:
      transform var(--dur-slide) var(--ease-out),
      background-color var(--dur-slide) var(--ease-out),
      filter var(--dur) var(--ease);
  }
  .wm-layer.is-parked { visibility: hidden; }
  .wm-scratch { z-index: 20; }
  html.scratch-on .wm-layer:not(.wm-scratch),
  html.scratch-on .wallpaper { filter: brightness(0.55); }
  .wm.is-overview .wm-layer { background-color: var(--mantle); }
  .wm.is-overview .wm-layer.is-empty { background-color: var(--crust); }

  .wm-overview[hidden] { display: none; }
  .wm-overview { animation: lock-in var(--dur) var(--ease-out); }
  .wm-cell {
    position: absolute;
    z-index: 10;
    display: flex;
    align-items: flex-end;
    padding: 0;
    border: 0;
    border-radius: var(--r-window);
    background: none;
    color: var(--subtext0);
    font: inherit;
    font-size: 0.82rem;
    text-align: left;
    cursor: pointer;
  }
  .wm-cell::before {
    content: '';
    position: absolute;
    inset: 0 0 var(--overview-label);
    border-radius: var(--r-window);
    transition: box-shadow var(--dur-fast) var(--ease);
  }
  .wm-cell:hover::before { box-shadow: 0 0 0 2px var(--surface1); }
  .wm-cell[aria-current='true']::before,
  .wm-cell:focus-visible::before { box-shadow: 0 0 0 2px var(--teal); }
  .wm-cell:focus-visible { outline: none; }
  .wm-cell-label {
    padding: 0.15rem 0.6rem;
    border-radius: var(--r-chip);
  }
  .wm-cell:hover .wm-cell-label { color: var(--text); }
  .wm-cell.is-empty .wm-cell-label { color: var(--overlay0); }
  .wm-cell[aria-current='true'] .wm-cell-label {
    background: var(--teal);
    color: var(--crust);
    font-weight: 700;
  }

  .wm-window {
    position: absolute;
    display: flex;
    flex-direction: column;
    overflow: auto;
    padding: 1.15rem 1.3rem;
    background: var(--base);
    border-radius: var(--r-window);
    box-shadow: var(--card-shadow);
    container-type: inline-size;
    scrollbar-color: var(--surface1) transparent;
    scrollbar-width: thin;
    transition:
      left var(--dur) var(--ease-jelly),
      top var(--dur) var(--ease-jelly),
      width var(--dur) var(--ease-jelly),
      height var(--dur) var(--ease-jelly),
      box-shadow var(--dur-fast) var(--ease),
      opacity var(--dur-fast) var(--ease),
      transform var(--dur) var(--ease-jelly);
  }
  .wm-window > * { flex-shrink: 0; }
  .wm-window:focus-visible { outline: none; }
  .wm-window.is-pre { opacity: 0; transform: scale(0.8); }
  .wm-window.is-closing {
    opacity: 0;
    transform: scale(0.85);
    pointer-events: none;
    transition-duration: 180ms;
  }
  .wm-window.is-focus {
    z-index: 2;
    box-shadow: 0 0 0 2px var(--teal), var(--card-shadow);
  }
  .wm-window.is-full { z-index: 5; }

  @media (prefers-reduced-motion: reduce) {
    main,
    .wm-layer,
    .wm-cell::before,
    .wm-window { transition: none; }
    .wm-overview { animation: none; }
  }

  .wm-window .path {
    display: block;
    margin-bottom: 0.7rem;
    font-size: 0.72rem;
    color: var(--overlay2);
  }
  .wm-window h3 { font-size: 1.1rem; margin-bottom: 0.5rem; }
  .wm-window h4 { font-size: 0.92rem; margin: 0.5rem 0 0.2rem; }
  .wm-window p {
    margin: 0 0 0.75rem;
    color: var(--subtext0);
    font-size: 0.88rem;
    line-height: 1.65;
  }
  .wm-window p:last-child { margin-bottom: 0; }
  .wm-window a { color: var(--text); }
  .wm-window .muted {
    font-size: 0.75rem;
    text-transform: lowercase;
    color: var(--overlay2);
  }
  .wm-window ul.plain,
  .wm-window ol.plain {
    list-style: none;
    margin: 0;
    padding: 0;
    color: var(--subtext0);
    font-size: 0.85rem;
    line-height: 1.6;
  }

  .wm-window h3:has(+ .tagline) {
    font-size: clamp(1.4rem, 4cqi, 2rem);
    font-weight: 800;
    letter-spacing: -0.045em;
  }
  .wm-window .tagline {
    margin-bottom: 1.1rem;
    color: var(--text);
    font-size: 0.95rem;
  }

  .wm-window > img {
    flex: 1 1 0;
    min-height: 0;
    width: 100%;
    height: auto;
    object-fit: cover;
    border-radius: var(--r-nest);
  }

  .wm-window .visual {
    margin-bottom: 0.9rem;
    border-radius: var(--r-nest);
    overflow: hidden;
    aspect-ratio: 16 / 9;
    background: var(--crust);
  }
  .wm-window .visual img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .wm-window .head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.3rem 1rem;
    margin-bottom: 0.4rem;
  }
  .wm-window .head h3 { margin: 0; font-size: 1.3rem; }
  .wm-window .live {
    padding: 0.15rem 0.5rem;
    border-radius: var(--r-chip);
    background: var(--surface0);
    color: var(--green);
    font-size: 0.7rem;
    white-space: nowrap;
  }
  .wm-window .live[data-state]::before {
    content: '';
    display: inline-block;
    width: 0.5em;
    height: 0.5em;
    margin-right: 0.45em;
    border-radius: 50%;
    background: currentColor;
  }
  .wm-window .live[data-state='down'] { color: var(--red); }
  .wm-window .desc { margin-bottom: 0.6rem; }
  .wm-window .stack,
  .wm-window .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    margin: 0 0 0.7rem;
    padding: 0;
    list-style: none;
  }
  .wm-window .stack li,
  .wm-window .tags li {
    padding: 0.15rem 0.5rem;
    border-radius: var(--r-chip);
    background: var(--surface0);
    color: var(--subtext1);
    font-size: 0.72rem;
  }
  .wm-window .tags li { color: var(--green); }
  .wm-window .tags.dislikes li { color: var(--red); }
  .wm-window .repo {
    color: var(--overlay2);
    font-size: 0.76rem;
    overflow-wrap: anywhere;
    text-decoration: none;
  }
  .wm-window .repo:hover { color: var(--text); }
  .wm-window .links {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.2rem 1rem;
  }
  .wm-window .meta {
    color: var(--overlay2);
    font-size: 0.76rem;
    font-variant-numeric: tabular-nums;
  }
  .wm-window .projects-list .meta {
    display: block;
    margin-top: 0.4rem;
  }
  .wm-window .projects-list > li { margin-bottom: 1rem; }
  .wm-window .projects-list > li:last-child { margin-bottom: 0; }
  .wm-window .projects-list > li > a {
    font-weight: 700;
    text-decoration: none;
  }
  .wm-window .projects-list .desc { margin: 0.15rem 0 0.4rem; }
  .wm-window .projects-list .stack { margin: 0; }

  .wm-window .week-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.2rem 1rem;
  }
  .wm-window .week-head h3 { margin: 0; }
  .wm-window .week h4 {
    margin: 0.9rem 0 0.45rem;
    color: var(--overlay2);
    font-size: 0.76rem;
    font-weight: 400;
  }
  .wm-window .week-artists li {
    display: grid;
    grid-template-columns: 28px minmax(0, 1fr) minmax(3rem, 35%) 3ch;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.35rem;
  }
  .wm-window .week-artists img,
  .wm-window .week-artists .noimg {
    width: 28px;
    height: 28px;
    border-radius: var(--r-chip);
    object-fit: cover;
    background: var(--surface0);
  }
  .wm-window .week .name {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .wm-window .week-artists .track {
    height: 6px;
    border-radius: 3px;
    background: var(--surface0);
    overflow: hidden;
  }
  .wm-window .week-artists .bar {
    display: block;
    height: 100%;
    border-radius: 3px;
    background: var(--teal);
  }
  .wm-window .week .count {
    text-align: right;
    color: var(--overlay2);
    font-size: 0.76rem;
    font-variant-numeric: tabular-nums;
  }
  .wm-window .week-grid {
    display: grid;
    grid-template-columns: auto repeat(24, minmax(0, 1fr));
    align-items: center;
    gap: 2px;
    margin-top: 1rem;
  }
  .wm-window .week-grid .day {
    padding-right: 0.4rem;
    color: var(--overlay2);
    font-size: 0.66rem;
    line-height: 1;
  }
  .wm-window .week-grid .cell {
    aspect-ratio: 1;
    border-radius: 2px;
    background: var(--surface0);
  }
  .wm-window .week-grid .cell[data-level='1'] { background: color-mix(in srgb, var(--teal) 30%, var(--surface0)); }
  .wm-window .week-grid .cell[data-level='2'] { background: color-mix(in srgb, var(--teal) 55%, var(--surface0)); }
  .wm-window .week-grid .cell[data-level='3'] { background: color-mix(in srgb, var(--teal) 78%, var(--surface0)); }
  .wm-window .week-grid .cell[data-level='4'] { background: var(--teal); }
  .wm-window .week-tracks li {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.3rem;
  }
  .wm-window .week-tracks a {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.5rem;
    min-width: 0;
    text-decoration: none;
  }
  .wm-window .week-tracks .artist { color: var(--overlay2); }
  .wm-window .week > .repo {
    display: inline-block;
    margin-top: 0.8rem;
  }

  .wm-window .fetch {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1rem 2rem;
    align-items: start;
  }
  .wm-window .logo {
    margin: 0;
    color: var(--teal);
    font-weight: 700;
    font-size: 0.9rem;
    line-height: 1.25;
    white-space: pre;
  }
  .wm-window .logo .b { color: var(--sky); }
  .wm-window .fetch .info { min-width: 0; }
  .wm-window .fetch .host {
    margin: 0 0 0.35rem;
    color: var(--text);
    font-weight: 700;
    font-size: 0.95rem;
  }
  .wm-window .fetch dl {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 0.3rem 1.5rem;
    margin: 0.75rem 0 1rem;
  }
  .wm-window .fetch .row { display: contents; }
  .wm-window .fetch dt { color: var(--overlay2); font-size: 0.86rem; text-transform: lowercase; }
  .wm-window .fetch dd { margin: 0; color: var(--text); font-size: 0.86rem; }
  .wm-window .palette { display: flex; gap: 0.4rem; }
  .wm-window .palette span { width: 1rem; height: 1rem; border-radius: 4px; }
  @container (max-width: 520px) {
    .wm-window .fetch { grid-template-columns: 1fr; }
  }

  .wm-window .card-title { margin-bottom: 0.9rem; }
  .wm-window .cat { margin-bottom: 0.9rem; }
  .wm-window .cat:last-child { margin-bottom: 0; }
  .wm-window .cat-label,
  .wm-window .tag-label {
    display: block;
    margin-bottom: 0.3rem;
    font-size: 0.78rem;
    text-transform: lowercase;
    color: var(--overlay2);
  }

  .wm-window .pax {
    display: grid;
    grid-template-columns: 1fr minmax(110px, 34%);
    gap: 1rem;
    align-items: start;
  }
  .wm-window .pax > * { min-width: 0; }
  .wm-window .pax .meta {
    margin-bottom: 0.8rem;
    font-size: 0.78rem;
    text-transform: lowercase;
    color: var(--overlay2);
  }
  .wm-window .pax .bio { font-style: italic; }
  .wm-window .pax .tags { margin-bottom: 0.6rem; }
  .wm-window .pax-photo img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--r-nest);
    background: var(--crust);
  }

  .wm-window .row-cats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 1rem;
  }
  .wm-window .row-cats .cat { margin: 0; min-width: 0; }
  .wm-window .row-cats .visual { aspect-ratio: 4 / 3; margin-bottom: 0.5rem; }
  .wm-window .row-cats p { font-size: 0.8rem; line-height: 1.5; }

  .wm-window .tile {
    display: flex;
    flex: 1;
    align-items: center;
    gap: 0.85rem;
    min-width: 0;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    text-align: left;
    text-decoration: none;
    cursor: pointer;
  }
  .wm-window .tile svg { flex-shrink: 0; color: var(--teal); }
  .wm-window .tile > div { min-width: 0; }
  .wm-window .tile .label {
    display: block;
    font-size: 0.72rem;
    text-transform: lowercase;
    color: var(--overlay2);
  }
  .wm-window .tile .value {
    display: block;
    overflow: hidden;
    color: var(--text);
    font-size: 0.92rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .wm-window .discord.copied .value { color: var(--green); }
  .wm-window .gpg .value {
    white-space: normal;
    font-variant-numeric: tabular-nums;
  }

  .wm-window .keys {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 0.45rem 1.25rem;
    margin: 0.4rem 0 1rem;
  }
  .wm-window .keys .row { display: contents; }
  .wm-window .keys dt {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    color: var(--overlay2);
  }
  .wm-window .keys dd {
    margin: 0;
    color: var(--subtext0);
    font-size: 0.86rem;
  }
  .wm-window > .term {
    flex: 1 1 0;
    min-height: 0;
    overflow-y: auto;
    font-size: 0.86rem;
    line-height: 1.55;
    scrollbar-color: var(--surface1) transparent;
    scrollbar-width: thin;
  }
  .wm-window .term-row {
    min-height: 1lh;
    color: var(--text);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  .wm-window .term-row.is-err { color: var(--red); }
  .wm-window .term-row.is-ok { color: var(--green); }
  .wm-window .term-prompt { color: var(--subtext0); }
  .wm-window .term-line {
    display: flex;
    align-items: baseline;
    gap: 0.5ch;
  }
  .wm-window .term-line input {
    flex: 1;
    min-width: 0;
    padding: 0;
    border: 0;
    outline: none;
    background: none;
    color: var(--text);
    caret-color: var(--teal);
    font: inherit;
  }

  /* Layout of hyprlock.nix: teal clock, date, field, and the blurred, darkened wallpaper behind. */
  .lock {
    position: fixed;
    inset: 0;
    z-index: 90;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    color: var(--subtext0);
    text-align: center;
    animation: lock-in var(--dur-fast) var(--ease);
  }
  .lock[hidden] { display: none; }
  .lock:focus-visible { outline: none; }
  .lock p { margin: 0; }
  .lock-time {
    color: var(--teal);
    font-size: clamp(4.5rem, 13vw, 9.5rem);
    font-weight: 800;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.04em;
    line-height: 1;
  }
  .lock-date {
    padding: 0.9rem 0 2rem;
    font-size: 1.3rem;
  }
  .lock-field {
    display: grid;
    place-items: center;
    width: min(300px, 80vw);
    height: 54px;
    border-radius: var(--r-card);
    background: var(--base);
    box-shadow: 0 0 0 2px var(--teal), var(--card-shadow);
    color: var(--text);
    font-size: 0.88rem;
  }
  .lock-track {
    position: absolute;
    bottom: 3.5rem;
    max-width: 90vw;
    overflow: hidden;
    font-size: 0.95rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .lock-track[hidden] { display: none; }
  .lock-track .note { color: var(--teal); }
  @keyframes lock-in {
    from { opacity: 0; }
  }

  /* Measures of catppuccin-zen.rasi: 600px window, 20px radius, 14px padding, eight lines. */
  .launcher {
    position: fixed;
    inset: 0;
    z-index: 80;
    display: grid;
    place-items: center;
    animation: lock-in var(--dur-fast) var(--ease-out);
  }
  .launcher[hidden] { display: none; }
  .launcher-box {
    display: flex;
    flex-direction: column;
    gap: 10px;
    width: min(600px, calc(100vw - 2rem));
    padding: 14px;
    border-radius: 20px;
    background: var(--mantle);
    box-shadow: var(--card-shadow);
  }
  .launcher-input {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 10px 14px;
    border-radius: var(--r-window);
    background: var(--surface0);
    color: var(--teal);
  }
  .launcher-input svg { flex-shrink: 0; }
  .launcher-input input {
    flex: 1;
    min-width: 0;
    padding: 0;
    border: 0;
    outline: none;
    background: none;
    color: var(--text);
    caret-color: var(--teal);
    font: inherit;
    font-size: 0.92rem;
  }
  .launcher-input input::placeholder {
    color: var(--overlay2);
    opacity: 1;
  }
  .launcher [role='listbox'] {
    display: flex;
    flex-direction: column;
    gap: 4px;
    height: min(8 * 40px + 7 * 4px, 100vh - 12rem);
    margin: 0;
    padding: 0;
    overflow-y: auto;
    list-style: none;
    scrollbar-width: none;
  }
  .launcher [role='option'] {
    display: flex;
    flex-shrink: 0;
    align-items: baseline;
    gap: 10px;
    height: 40px;
    padding: 8px 10px;
    border-radius: var(--r-nest);
    color: var(--text);
