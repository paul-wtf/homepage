---
import { contactIcons } from '../data/contact';

interface Props {
  user: string;
  domain: string;
  label: string;
  placeholder: string;
}
const { user, domain, label, placeholder } = Astro.props;
---
<button
  type="button"
  class="window window--focusable tile email"
  data-email-user={user}
  data-email-domain={domain}
>
  <svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true">
    <path fill="currentColor" d={contactIcons.email}/>
  </svg>
  <div>
    <span class="label">{label}</span>
    <span class="value" data-email-text>{placeholder}</span>
    <span class="sr-only">— in Mail-Client öffnen</span>
  </div>
</button>

<style>
  .tile {
    display: flex; align-items: center; gap: 0.85rem;
    padding: 1rem 1.15rem;
    text-decoration: none; color: inherit;
    border: 0;
    cursor: pointer; text-align: left;
    font: inherit;
    width: 100%;
    min-width: 0;
  }
  /* Ohne min-width:0 greift das text-overflow: ellipsis der .value nie */
  .tile > div { min-width: 0; }
  .tile svg { flex-shrink: 0; color: var(--teal); }
  .label {
    display: block; font-size: 0.72rem;
    text-transform: lowercase;
    color: var(--overlay2);
  }
  .value {
    display: block; color: var(--text); font-size: 0.88rem;
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
</style>
