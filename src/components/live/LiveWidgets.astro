<div class="live" data-live-root hidden>
  <button
    type="button"
    class="live-w"
    data-live="music"
    aria-expanded="false"
    aria-controls="live-popout"
    hidden
  ><span class="note" aria-hidden="true">♪</span><span class="eq" aria-hidden="true"><i></i><i></i><i></i></span><span class="live-text" data-text></span></button>
  <button
    type="button"
    class="live-w"
    data-live="server"
    aria-expanded="false"
    aria-controls="live-popout"
    hidden
  ><span class="key" aria-hidden="true">cpu</span><span data-text></span></button>
  <button
    type="button"
    class="live-w"
    data-live="weather"
    aria-expanded="false"
    aria-controls="live-popout"
    hidden
  ><span class="glyph" data-glyph aria-hidden="true"></span><span data-text></span></button>
  <div id="live-popout" class="popout" data-live-popout role="region" hidden></div>
</div>
<div class="toasts" data-toasts aria-live="polite"></div>

<style>
  .live {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    min-width: 0;
  }
  .live[hidden] { display: none; }

  .live-w {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    flex: 0 0 auto;
    padding: 0.28rem 0.6rem;
    border: 0;
    border-radius: var(--r-chip);
    background: transparent;
    color: var(--subtext0);
    font: inherit;
    font-size: 0.82rem;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    cursor: pointer;
    transition:
      color var(--dur-fast) var(--ease),
      background var(--dur-fast) var(--ease);
  }
  .live-w[hidden] { display: none; }
  .live-w:hover,
  .live-w[aria-expanded='true'] {
    color: var(--text);
    background: var(--surface0);
  }

  .live-w[data-live='music'] {
    flex: 0 1 auto;
    min-width: 0;
    max-width: 22rem;
  }
  .live-text {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .note { color: var(--teal); }
  .eq {
    display: inline-flex;
    align-items: flex-end;
    gap: 2px;
    height: 0.75rem;
    margin-left: -0.15rem;
  }
  .eq i {
    width: 2px;
    height: 100%;
    border-radius: 1px;
    background: var(--teal);
    transform-origin: bottom;
  }
  .eq i:nth-child(1) { transform: scaleY(0.45); }
  .eq i:nth-child(2) { transform: scaleY(0.8); }
  .eq i:nth-child(3) { transform: scaleY(0.6); }
  .live-w[data-state='playing'] .eq i { animation: eq 0.9s var(--ease) infinite alternate; }
  .live-w[data-state='playing'] .eq i:nth-child(2) { animation-duration: 0.65s; animation-delay: -0.3s; }
  .live-w[data-state='playing'] .eq i:nth-child(3) { animation-duration: 1.15s; animation-delay: -0.6s; }
  @keyframes eq {
    from { transform: scaleY(0.25); }
    to { transform: scaleY(1); }
  }
  .key { color: var(--overlay2); }
  .glyph,
  .popout :global(.glyph) { font-variant-emoji: text; }

  .popout {
    position: absolute;
    top: calc(100% + 6px);
    left: 0;
    z-index: 1;
    width: min(20rem, calc(100vw - 16px));
    padding: 0.9rem 1rem;
    border-radius: var(--r-card);
    background: var(--mantle);
    box-shadow: var(--card-shadow);
    color: var(--subtext0);
    font-size: 0.82rem;
    line-height: 1.5;
  }
  .popout[hidden] { display: none; }
  .popout :global(p) { margin: 0; }

  .popout :global(.pop-music) {
    display: flex;
    gap: 0.85rem;
    align-items: flex-start;
  }
  .popout :global(.pop-music img) {
    flex: 0 0 auto;
    width: 72px;
    height: 72px;
    border-radius: var(--r-nest);
    object-fit: cover;
    background: var(--surface0);
  }
  .popout :global(.pop-music > div) { min-width: 0; }
  .popout :global(.pop-title) {
    color: var(--text);
    font-weight: 700;
    overflow-wrap: anywhere;
  }
  .popout :global(.pop-music p:not(.pop-title)) { overflow-wrap: anywhere; }
  .popout :global(.muted) { color: var(--overlay2); }
  .popout :global(a) {
    display: inline-block;
    margin-top: 0.35rem;
    color: var(--subtext1);
  }
  .popout :global(a:hover) { color: var(--text); }
  .popout :global(a + a) { margin-left: 0.9rem; }

  .popout :global(dl) {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.3rem 1rem;
    margin: 0;
  }
  .popout :global(dt) { color: var(--overlay2); }
  .popout :global(dd) {
    margin: 0;
    text-align: right;
    font-variant-numeric: tabular-nums;
  }
  .popout :global(.spark) {
    display: block;
    width: 100%;
    height: 32px;
    margin: 0.2rem 0 0.5rem;
  }

  .popout :global(.pop-weather) {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    margin-bottom: 0.5rem;
    color: var(--text);
    font-size: 1.4rem;
  }
  .popout :global(.pop-weather .cond) {
    color: var(--subtext0);
    font-size: 0.82rem;
  }

  /* Position and measures of NotificationPopup.qml in the zen variant. */
  .toasts {
    position: fixed;
    top: calc(var(--bar-h) + 10px);
    right: 18px;
    z-index: 2;
    width: min(360px, calc(100vw - 36px));
    pointer-events: none;
  }
  .toasts :global(.toast) {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    padding: 10px;
    border-radius: var(--r-card);
    background: var(--base);
    box-shadow: var(--card-shadow);
    pointer-events: auto;
    opacity: 0;
    transform: translateX(40px);
    transition:
      opacity var(--dur-fast) var(--ease),
      transform 220ms var(--ease-out);
  }
  .toasts :global(.toast.is-in) {
    opacity: 1;
    transform: none;
  }
  .toasts :global(img) {
    flex: 0 0 auto;
    width: 40px;
    height: 40px;
    border-radius: var(--r-chip);
    object-fit: cover;
    background: var(--surface0);
  }
  .toasts :global(.toast-text) {
    flex: 1;
    min-width: 0;
  }
  .toasts :global(p) {
    margin: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .toasts :global(.toast-app) {
    color: var(--overlay2);
    font-size: 0.7rem;
  }
  .toasts :global(.toast-title) {
    color: var(--text);
    font-size: 0.9rem;
    font-weight: 700;
  }
  .toasts :global(.toast-body) {
    color: var(--subtext0);
    font-size: 0.78rem;
  }
  .toasts :global(.toast-close) {
    flex: 0 0 auto;
    padding: 0 0.2rem;
    border: 0;
    background: none;
    color: var(--subtext1);
    font: inherit;
    font-size: 0.8rem;
    line-height: 1.2;
    cursor: pointer;
  }
  .toasts :global(.toast-close:hover) { color: var(--text); }

  @media (max-width: 960px) {
    .live-w[data-live='server'],
    .live-w[data-live='weather'] { display: none; }
  }
  @media (max-width: 780px) {
    .live-text { display: none; }
    .live-w[data-live='music'] { padding: 0.28rem 0.55rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .live-w { transition: none; }
    .live-w[data-state='playing'] .eq i { animation: none; }
    .toasts :global(.toast) {
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  import { latest, startPolling, subscribe, type Music, type Status } from '../../scripts/live/status';
  import { ui, type Ui } from '../../data/ui';
  import { lang } from '../../scripts/lang';

  const t = ui[lang].live;
  const LINKHOP = 'https://linkhop.paul.wtf/';

  type Name = 'music' | 'server' | 'weather';

  const root = document.querySelector<HTMLElement>('[data-live-root]');
  const pop = document.querySelector<HTMLElement>('[data-live-popout]');
  const widgets = new Map<Name, HTMLButtonElement>();
  for (const el of document.querySelectorAll<HTMLButtonElement>('button[data-live]')) {
    widgets.set(el.dataset.live as Name, el);
  }

  const WMO: [number[], string, keyof Ui['live']['conditions']][] = [
    [[0], '☀︎', 'sunny'],
    [[1], '◐', 'mostlyClear'],
    [[2], '◐', 'partlyCloudy'],
    [[3], '☁︎', 'overcast'],
    [[45, 48], '≋', 'fog'],
    [[51, 53, 55], '☂︎', 'drizzle'],
    [[56, 57], '☂︎', 'freezingDrizzle'],
    [[61, 63], '☂︎', 'rain'],
    [[65], '☂︎', 'heavyRain'],
    [[66, 67], '☂︎', 'freezingRain'],
    [[80, 81, 82], '☂︎', 'showers'],
    [[71, 73, 77], '❄︎', 'snow'],
    [[75], '❄︎', 'heavySnow'],
    [[85, 86], '❄︎', 'snowShowers'],
    [[95], 'ϟ', 'thunderstorm'],
    [[96, 99], 'ϟ', 'hail'],
  ];

  function condition(code: number, isDay: boolean): { glyph: string; text: string } {
    if (code === 0 && !isDay) return { glyph: '☾', text: t.conditions.clearNight };
    const hit = WMO.find(([codes]) => codes.includes(code));
    return hit ? { glyph: hit[1], text: t.conditions[hit[2]] } : { glyph: '·', text: t.conditions.unknown };
  }

  const pct = (n: number) => `${n.toFixed(1)}%`;
  const deg = (n: number) => `${Math.round(n)}°`;

  function uptime(s: number): string {
    const d = Math.floor(s / 86400);
    if (d > 0) return t.days(d);
    const h = Math.floor(s / 3600);
    return h > 0 ? t.hours(h) : t.minutes(Math.floor(s / 60));
  }

  function ago(iso: string | null): string {
    const at = iso ? Date.parse(iso) : NaN;
    if (Number.isNaN(at)) return t.recent;
    const min = Math.max(1, Math.round((Date.now() - at) / 60_000));
    return min < 60 ? t.minutesAgo(min) : t.hoursAgo(Math.round(min / 60));
  }

  function el<K extends keyof HTMLElementTagNameMap>(
    tag: K,
    text?: string,
    cls?: string
  ): HTMLElementTagNameMap[K] {
    const e = document.createElement(tag);
    if (text !== undefined) e.textContent = text;
    if (cls) e.className = cls;
    return e;
  }

  function sparkline(values: number[]): SVGSVGElement | null {
    if (values.length < 2) return null;
    const NS = 'http://www.w3.org/2000/svg';
    const top = Math.max(10, ...values) * 1.15;
    const step = 100 / (values.length - 1);
    const svg = document.createElementNS(NS, 'svg');
    svg.setAttribute('viewBox', '0 0 100 32');
    svg.setAttribute('preserveAspectRatio', 'none');
    svg.setAttribute('class', 'spark');
    svg.setAttribute('aria-hidden', 'true');
    const line = document.createElementNS(NS, 'polyline');
    line.setAttribute(
      'points',
      values.map((v, i) => `${(i * step).toFixed(2)},${(31 - (v / top) * 30).toFixed(2)}`).join(' ')
    );
    line.setAttribute('fill', 'none');
    line.setAttribute('stroke', 'var(--subtext0)');
    line.setAttribute('stroke-width', '1.5');
    line.setAttribute('stroke-linejoin', 'round');
    line.setAttribute('vector-effect', 'non-scaling-stroke');
    svg.append(line);
    return svg;
  }

  function rows(pairs: [string, string][]): HTMLDListElement {
    const dl = el('dl');
    for (const [k, v] of pairs) dl.append(el('dt', k), el('dd', v));
    return dl;
  }

  function popContent(name: Name, s: Status): Node | null {
    if (name === 'music' && s.music) {
      const m = s.music;
      const box = el('div', undefined, 'pop-music');
      if (m.image) {
        const img = el('img');
        img.src = m.image;
        img.alt = m.album ? t.coverOf(m.album) : t.cover;
        img.loading = 'lazy';
        img.width = 72;
        img.height = 72;
        box.append(img);
      }
      const text = el('div');
      text.append(el('p', m.track, 'pop-title'), el('p', m.artist));
      if (m.album) text.append(el('p', m.album, 'muted'));
      text.append(el('p', m.state === 'playing' ? t.playing : ago(m.played_at), 'muted'));
      const link = (label: string, href: string) => {
        const a = el('a', label);
        a.href = href;
        a.target = '_blank';
        a.rel = 'noopener noreferrer';
        text.append(a);
      };
      if (m.url) link(t.lastfm, m.url);
      link(t.linkhop, `${LINKHOP}?q=${encodeURIComponent(`${m.artist} ${m.track}`)}`);
      box.append(text);
      return box;
    }
    if (name === 'server' && s.server) {
      const v = s.server;
      const frag = document.createDocumentFragment();
      frag.append(rows([['load', v.load1.toFixed(2)], ['cpu', pct(v.cpu_pct)]]));
      const spark = sparkline(v.cpu_history);
      if (spark) frag.append(spark);
      frag.append(rows([[t.memory, pct(v.mem_pct)], ['uptime', uptime(v.uptime_s)]]));
      return frag;
    }
    if (name === 'weather' && s.weather) {
      const w = s.weather;
      const c = condition(w.code, w.is_day);
      const head = el('div', undefined, 'pop-weather');
      head.append(el('span', c.glyph, 'glyph'), el('span', `${w.temp_c.toFixed(1)} °C`), el('span', c.text, 'cond'));
      const frag = document.createDocumentFragment();
      frag.append(head, rows([[t.place, 'Bierwang'], ['wind', `${Math.round(w.wind_kmh)} km/h`]]));
      return frag;
    }
    return null;
  }

  const LABELS: Record<Name, string> = { music: t.music, server: t.server, weather: t.weather };

  function renderWidgets(s: Status | null): void {
    for (const [name, btn] of widgets) {
      const text = btn.querySelector<HTMLElement>('[data-text]');
      let label: string | null = null;
      if (name === 'music' && s?.music) {
        const m = s.music;
        if (text) text.textContent = `${m.track} · ${m.artist}`;
        btn.dataset.state = m.state;
        label = t.musicLabel(m.track, m.artist);
      } else if (name === 'server' && s?.server) {
        if (text) text.textContent = pct(s.server.cpu_pct);
        label = `${t.server}: CPU ${pct(s.server.cpu_pct)}`;
      } else if (name === 'weather' && s?.weather) {
        const c = condition(s.weather.code, s.weather.is_day);
        const glyph = btn.querySelector<HTMLElement>('[data-glyph]');
        if (glyph) glyph.textContent = c.glyph;
        if (text) text.textContent = deg(s.weather.temp_c);
        label = `${t.weather}: ${deg(s.weather.temp_c)}, ${c.text}`;
      }
      btn.hidden = label === null;
      if (label) btn.setAttribute('aria-label', label);
    }
    if (root) root.hidden = [...widgets.values()].every((b) => b.hidden);
  }

  let open: Name | null = null;
  let shown = '';

  function place(btn: HTMLElement): void {
    if (!pop) return;
    const nav = pop.offsetParent as HTMLElement | null;
    const navBox = (nav ?? document.body).getBoundingClientRect();
    const b = btn.getBoundingClientRect();
    const margin = 8;
    const max = navBox.width - pop.offsetWidth - margin;
    pop.style.left = `${Math.max(margin, Math.min(b.left - navBox.left, max))}px`;
  }

  function close(returnFocus: boolean): void {
    if (!pop || !open) return;
    const btn = widgets.get(open);
    open = null;
    pop.hidden = true;
    pop.replaceChildren();
    for (const b of widgets.values()) b.setAttribute('aria-expanded', 'false');
    if (returnFocus) btn?.focus();
  }

  function show(name: Name): void {
    const s = latest();
    const btn = widgets.get(name);
    const content = s && popContent(name, s);
    if (!pop || !btn || !content) return close(false);
    open = name;
    shown = JSON.stringify(s[name]);
    pop.replaceChildren(content);
    pop.setAttribute('aria-label', LABELS[name]);
    pop.hidden = false;
    for (const [n, b] of widgets) b.setAttribute('aria-expanded', String(n === name));
    place(btn);
  }

  for (const [name, btn] of widgets) {
    btn.addEventListener('click', () => {
      if (open === name) close(false);
      else show(name);
    });
  }

  document.addEventListener(
    'keydown',
    (e) => {
      if (e.key !== 'Escape' || !open) return;
      e.preventDefault();
      e.stopPropagation();
      close(true);
    },
    true
  );

  document.addEventListener(
    'pointerdown',
    (e) => {
      if (!open) return;
      const t = e.target as Node;
      if (pop?.contains(t) || [...widgets.values()].some((b) => b.contains(t))) return;
      close(false);
    },
    true
  );

  window.addEventListener('resize', () => {
    if (!open) return;
    const btn = widgets.get(open);
    if (btn && btn.getClientRects().length) place(btn);
    else close(false);
  });

  const toasts = document.querySelector<HTMLElement>('[data-toasts]');
  const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
  const TOAST_MS = 5000;
  const TOAST_FADE_MS = 200;
  let toastTimer = 0;
  let heard: string | null = null;
  let answered = false;

  function dismiss(node: HTMLElement): void {
    node.classList.remove('is-in');
    if (reducedMotion.matches) node.remove();
    else setTimeout(() => node.remove(), TOAST_FADE_MS);
  }

  function announce(m: Music): void {
    if (!toasts) return;
    clearTimeout(toastTimer);
    const node = el('div', undefined, 'toast');
    if (m.image) {
      const img = el('img');
      img.src = m.image;
      img.alt = '';
      img.width = 40;
      img.height = 40;
      node.append(img);
    }
    const text = el('div', undefined, 'toast-text');
    text.append(
      el('p', m.state === 'playing' ? t.toastPlaying : t.toastRecent, 'toast-app'),
      el('p', m.track, 'toast-title'),
      el('p', m.artist, 'toast-body')
    );
    const close = el('button', '✕', 'toast-close');
    close.type = 'button';
    close.setAttribute('aria-label', t.toastClose);
    close.addEventListener('click', () => {
      clearTimeout(toastTimer);
      dismiss(node);
    });
    node.append(text, close);
    toasts.replaceChildren(node);
    void node.offsetWidth;
    node.classList.add('is-in');
    toastTimer = window.setTimeout(() => dismiss(node), TOAST_MS);
  }

  function trackChange(s: Status | null): void {
    if (!s) return;
    const key = s.music ? `${s.music.artist}\n${s.music.track}` : null;
    if (answered && s.music && key !== heard) announce(s.music);
    if (key) heard = key;
    answered = true;
  }

  subscribe((s) => {
    renderWidgets(s);
    trackChange(s);
    if (!open) return;
    const key = JSON.stringify(s?.[open] ?? null);
    if (key !== shown) show(open);
  });
  startPolling();
</script>
